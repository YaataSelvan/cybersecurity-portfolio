	<script>
		const tabs = document.querySelectorAll(".experience-tab");
		const panels = document.querySelectorAll(".experience-panel");

		tabs.forEach((tab) => {
			tab.addEventListener("click", () => {
				const job = tab.getAttribute("data-job");

				if (!job) return;

				tabs.forEach((item) => item.classList.remove("active"));
				panels.forEach((panel) => panel.classList.remove("active"));

				tab.classList.add("active");
				document.getElementById(job)?.classList.add("active");
			});
		});

		const projectTabs = document.querySelectorAll(".project-tab");
		const projectPanels = document.querySelectorAll(".project-panel");

		projectTabs.forEach((tab) => {
  			tab.addEventListener("click", () => {
    			const project = tab.getAttribute("data-project");

    			if (!project) return;

    			projectTabs.forEach((item) => item.classList.remove("active"));

    			projectPanels.forEach((panel) =>
      				panel.classList.remove("active")
    			);

    			tab.classList.add("active");

    			document
      			.getElementById(project)
      			?.classList.add("active");
  			});
		});
	</script>



